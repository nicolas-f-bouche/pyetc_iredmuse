# Include important metadata files
include README.md
include LICENSE
include requirements.txt

# Include data files
recursive-include pyetc_iredmuse VERSION
recursive-include pyetc_iredmuse/data *
recursive-include pyetc_iredmuse/Band_Filters *.txt
recursive-include pyetc_iredmuse/ESO_original_spectra *

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.so
